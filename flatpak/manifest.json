{
    "app-id": "io.github.jcfain.XTPlayer",
    "runtime": "org.freedesktop.Platform/$ARCH/26.08",
    "sdk": "org.freedesktop.Sdk/$ARCH/26.08",
    "command": "XTPlayer",
    "build-options": {
        "strip": true
    },
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--socket=session-bus",
        "--talk-name=org.bluez",
        "--device=all",
        "--filesystem=/run/udev:ro",
        "--filesystem=xdg-run/gamescope-0:ro",
        "--filesystem=host",
        "--env=QT_MULTIMEDIA_PREFERRED_PLUGINS=ffmpeg"
    ],
    "cleanup": [
        "/bin/qmake",
        "/bin/qmake6",
        "/bin/qtpaths",
        "/bin/qtpaths6",
        "/bin/qtdiag",
        "/bin/qtdiag6",
        "/bin/lrelease",
        "/bin/lrelease-pro",
        "/lib/libexec/moc",
        "/lib/libexec/rcc",
        "/lib/libexec/uic",
        "/lib/libexec/lrelease",
        "/lib/libexec/cmake_automoc_parser",
        "/lib/libexec/qt-cmake-private",
        "/lib/libexec/qt-internal-configure-examples",
        "/lib/libexec/qt-internal-configure-tests",
        "/lib/libexec/syncqt",
        "/lib/libexec/tracegen",
        "/lib/libexec/tracepointgen",
        "/lib/libexec/qvkgen",
        "/lib/libexec/qtwaylandscanner",
        "*.a",
        "include/",
        "mkspecs/",
        "lib/cmake/",
        "lib/pkgconfig/",
        "share/man/",
        "share/doc/",
        "doc/",
        "src/"
    ],
    "modules": [
        {
            "name": "dav1d",
            "buildsystem": "meson",
            "config-opts": [
                "-Denable_asm=true",
                "-Denable_docs=false"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/videolan/dav1d",
                    "tag": "1.5.1"
                }
            ]
        },
        {
            "name": "aom",
            "buildsystem": "simple",
            "build-commands": [
                "cmake -G Ninja -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=ON -DCMAKE_INSTALL_PREFIX=/app -DENABLE_APPS=OFF -DENABLE_EXAMPLES=OFF -DENABLE_TESTS=OFF -DENABLE_TOOLS=OFF -DENABLE_DOCS=OFF -S . -B _build",
                "cmake --build _build",
                "cmake --install _build"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://aomedia.googlesource.com/aom",
                    "tag": "v3.15.2"
                }
            ]
        },
        {
            "name": "ffmpeg-av1",
            "buildsystem": "autotools",
            "config-opts": {
                "aarch64": [
                    "--enable-shared",
                    "--enable-libdav1d",
                    "--enable-libaom",
                    "--enable-network",
                    "--enable-v4l2-m2m",
                    "--disable-libpulse",
                    "--disable-doc"
                ],
                "x86_64": [
                    "--enable-shared",
                    "--enable-libdav1d",
                    "--enable-libaom",
                    "--enable-network",
                    "--enable-vaapi",
                    "--enable-vdpau",
                    "--enable-vulkan",
                    "--disable-libpulse",
                    "--disable-doc"
                ]
            },
            "sources": [
                {
                    "type": "archive",
                    "url": "https://ffmpeg.org/releases/ffmpeg-9.0.1.tar.xz",
                    "sha256": "cf38e0e28c7e5605942c4a77755349b0145804a397af37eb1fb4c77cb237f635"
                }
            ]
        },
        {
            "name": "qtbase",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DINSTALL_LIBDIR=lib",
                "-DINSTALL_ARCHDATADIR=lib",
                "-DQT_CREATE_VERSIONED_HARD_LINK=OFF",
                "-DQT_DISABLE_RPATH=ON",
                "-DBUILD_WITH_PCH=FALSE",
                "-DQT_FEATURE_openssl_linked=ON",
                "-DQT_FEATURE_system_sqlite=ON"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://files.kde.org/qt/official_releases/qt/6.12/6.12.0/submodules/qtbase-everywhere-src-6.12.0.tar.xz",
                    "sha256": "a951bd163c7b80fc6b8c88d7668fb56abf91c152373e13c10666763238131307"
                },
                {
                    "type": "patch",
                    "path": "patches/qtbase-find_package-paths.patch"
                }
            ]
        },
        {
            "name": "qttools",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DQT_FEATURE_designer=OFF",
                "-DQT_FEATURE_pixeltool=OFF",
                "-DQT_FEATURE_distancefieldgenerator=OFF",
                "-DQT_FEATURE_qev=OFF",
                "-DQT_FEATURE_kmap2qmap=OFF"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://files.kde.org/qt/official_releases/qt/6.12/6.12.0/submodules/qttools-everywhere-src-6.12.0.tar.xz",
                    "sha256": "8dab8f3611496486a470ad5f115ceea584f36bc22a2b8b6f6ebdbafbb8160693"
                }
            ]
        },
        {
            "name": "qtshadertools",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://files.kde.org/qt/official_releases/qt/6.12/6.12.0/submodules/qtshadertools-everywhere-src-6.12.0.tar.xz",
                    "sha256": "c7d84f436e1aaef39fdcadebf2bd71bdf24dc69497e13f2e0198873cbbfea2ab"
                }
            ]
        },
        {
            "name": "qtsvg",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://files.kde.org/qt/official_releases/qt/6.12/6.12.0/submodules/qtsvg-everywhere-src-6.12.0.tar.xz",
                    "sha256": "e4ab39534ec97987b1b9b60ef7f4d3253d5912a69f8c713a01753174a4029331"
                }
            ]
        },
        {
            "name": "qtimageformats",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://files.kde.org/qt/official_releases/qt/6.12/6.12.0/submodules/qtimageformats-everywhere-src-6.12.0.tar.xz",
                    "sha256": "0943132b5db8de6b6a7f1d162682173e8763c7ed94e80fd39113292845f67762"
                }
            ]
        },
        {
            "name": "qtserialport",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://files.kde.org/qt/official_releases/qt/6.12/6.12.0/submodules/qtserialport-everywhere-src-6.12.0.tar.xz",
                    "sha256": "ba8886a54eee466e57c9fa1341255cc09c462c84baab3ee7b19d67cdbcbd71c3"
                }
            ]
        },
        {
            "name": "qtwebsockets",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://files.kde.org/qt/official_releases/qt/6.12/6.12.0/submodules/qtwebsockets-everywhere-src-6.12.0.tar.xz",
                    "sha256": "21690a365cd5fbfa8dea051473e98968df9f4eca0121fed7481d1215b7455a31"
                }
            ]
        },
        {
            "name": "qtconnectivity",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://files.kde.org/qt/official_releases/qt/6.12/6.12.0/submodules/qtconnectivity-everywhere-src-6.12.0.tar.xz",
                    "sha256": "ed51f7f02c1f437fcf8a42940c7a84f6c0908c0ec7a4f5a5304fe68f47521954"
                }
            ]
        },
        {
            "name": "qtmultimedia",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://files.kde.org/qt/official_releases/qt/6.12/6.12.0/submodules/qtmultimedia-everywhere-src-6.12.0.tar.xz",
                    "sha256": "3143f53b64257ba2a0685c940f5dce476c75871ff86b516de45cfd54ea93a62d"
                }
            ]
        },
        {
            "name": "espeak-ng",
            "buildsystem": "autotools",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/espeak-ng/espeak-ng/archive/refs/tags/1.52.0.tar.gz",
                    "sha256": "bb4338102ff3b49a81423da8a1a158b420124b055b60fa76cfb4b18677130a23"
                }
            ]
        },
        {
            "name": "dotconf",
            "buildsystem": "autotools",
            "sources": [
                {
                    "type": "archive",
                    "path": "vendor/dotconf-1.4.1.tar.gz",
                    "sha256": "4bf9f3fd261ee3890082fc1ee194a3be79bd922bd857d8e2817982cc68148a9e"
                }
            ]
        },
        {
            "name": "speech-dispatcher",
            "buildsystem": "autotools",
            "config-opts": [
                "--with-espeak-ng",
                "--without-espeak",
                "--without-flite",
                "--without-ibmtts",
                "--without-voxin",
                "--without-ivona",
                "--without-pico",
                "--without-baratinoo",
                "--without-kali",
                "--with-pulse",
                "--with-default-audio-method=pulse",
                "--disable-python",
                "--disable-doc"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://deb.debian.org/debian/pool/main/s/speech-dispatcher/speech-dispatcher_0.12.1.orig.tar.gz",
                    "sha256": "b14a5238d287d2dcce4dd42bbd66ca65fa228e7e683708267f7b34036f7ba4b4"
                }
            ]
        },
        {
            "name": "qtspeech",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://files.kde.org/qt/official_releases/qt/6.12/6.12.0/submodules/qtspeech-everywhere-src-6.12.0.tar.xz",
                    "sha256": "9a60ce5bee54a9343740feab2582bffb996812f43d6c5585aade26dbd04933db"
                }
            ]
        },
        {
            "name": "qtwayland",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://files.kde.org/qt/official_releases/qt/6.12/6.12.0/submodules/qtwayland-everywhere-src-6.12.0.tar.xz",
                    "sha256": "ae14d9bcf1bb3c300a3ab2e6a53f50284e5c6c966a4ac4cc5aedcb1bc74e4d02"
                }
            ]
        },
        {
            "name": "qthttpserver",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://files.kde.org/qt/official_releases/qt/6.12/6.12.0/submodules/qthttpserver-everywhere-src-6.12.0.tar.xz",
                    "sha256": "ede040264551d0930ea5f6c1a4c18a7a3dea59d635e71cd2e81f02567d7814a4"
                }
            ]
        },
        {
            "name": "qttranslations",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://files.kde.org/qt/official_releases/qt/6.12/6.12.0/submodules/qttranslations-everywhere-src-6.12.0.tar.xz",
                    "sha256": "85929c0c30d6f273f23bd879bb69803ea17b010ab73cab2f8abf95357f6f6bbb"
                }
            ]
        },
        {
            "name": "qtgamepadlegacy",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DQT_GENERATE_SBOM=OFF"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/pumphaus/qtgamepadlegacy",
                    "commit": "434fe59d70f42fa0f745af05921ba64169fce90b"
                },
                {
                    "type": "patch",
                    "path": "patches/qtgamepadlegacy-no-qml.patch"
                }
            ]
        },
        {
            "name": "xtp-web",
            "buildsystem": "simple",
            "build-commands": [
                "mkdir -p /app/src/xtp-web",
                "cp -r web/* /app/src/xtp-web/"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/jcfain/XTPlayer/releases/download/v0.6.11b/xtp-web-v0.6.11b.tar.xz",
                    "dest": "web"
                }
            ]
        },
        {
            "name": "xtplayer",
            "buildsystem": "simple",
            "build-commands": [
                "rm -rf XTEngine/src/www && mkdir -p XTEngine/src/www && cp -r /app/src/xtp-web/* XTEngine/src/www/",
                "mkdir -p XTEngine/build-release && cd XTEngine/build-release && /app/bin/qmake ../src/XTEngine.pro CONFIG+=release && make -j$(nproc)",
                "mkdir -p XTPlayer/build && cd XTPlayer/build && /app/bin/qmake ../src/XTPlayer.pro CONFIG+=release && make -j$(nproc)",
                "install -Dm755 XTPlayer/build/release/XTPlayer /app/bin/XTPlayer",
                "cp -a XTEngine/build-release/release/libxtengine.so* /app/lib/",
                "mkdir -p /app/bin/www && cp -r XTPlayer/build/release/www/. /app/bin/www/",
                "mkdir -p /app/bin/themes && cp -r XTPlayer/build/release/themes/. /app/bin/themes/",
                "mkdir -p /app/bin/translations && cp -r XTPlayer/build/release/translations/. /app/bin/translations/ 2>/dev/null || true",
                "V=$(awk '/#define VERSION_MAJOR/{m=$3} /#define VERSION_MINOR/{n=$3} /#define VERSION_REVISION/{r=$3} /#define VERSION_PHASE/{p=$3} END{printf \"%d.%d.%d%s\", m, n, r, p}' XTEngine/src/XTEngine_global.h) && sed -i \"s/^Version=.*/Version=$V/\" XTPlayer/flatpak/XTPlayer.desktop",
                "install -Dm644 XTPlayer/flatpak/XTPlayer.desktop /app/share/applications/io.github.jcfain.XTPlayer.desktop",
                "install -Dm644 XTPlayer/src/images/icons/XTP-icon.png /app/share/icons/hicolor/256x256/apps/io.github.jcfain.XTPlayer.png"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/jcfain/XTPlayer",
                    "tag": "v0.6.11b",
                    "dest": "XTPlayer"
                },
                {
                    "type": "git",
                    "url": "https://github.com/jcfain/XTEngine",
                    "tag": "v0.6.11b",
                    "dest": "XTEngine"
                }
            ]
        }
    ]
}